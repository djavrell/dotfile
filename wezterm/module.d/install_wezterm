# vim: ft=zsh

# Windows-side config, pointed to by WEZTERM_CONFIG_FILE: loads the repo config through \\wsl.localhost
function wezterm_stub_path() { print -r -- "$W_XDG_CONFIG_HOME/wezterm/wezterm.lua" }

function wezterm_stub() {
  local dir=$(wslpath -w "$DOTFILE/wezterm")
  cat <<LUA
-- generated by \`dots link\` (wezterm/module.d/install_wezterm), edit the repo instead
local wezterm = require('wezterm')
local dir = [[$dir]]
package.path = dir .. [[\?.lua;]] .. dir .. [[\?\init.lua;]] .. package.path
wezterm.add_to_config_reload_watch_list(dir .. [[\wezterm.lua]])
local config = dofile(dir .. [[\wezterm.lua]])
-- colors/ is looked up next to the config file, which is this stub
config.color_scheme_dirs = { dir .. [[\colors]] }
return config
LUA
}

function install_wezterm() {
  [[ $SYSTEM == wsl ]] || return 0
  local stub=$(wezterm_stub_path)
  [[ "$(<$stub)" == "$(wezterm_stub)" ]] 2>/dev/null && { log_skip "$stub"; return }
  mkdir -p "${stub:h}" && wezterm_stub > "$stub" && log_success "$stub (stub Windows)"
}
