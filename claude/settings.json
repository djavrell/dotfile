{
  "permissions": {
    "allow": [
      "Skill(code-review:code-review)",
      "Bash(gh repo:*)",
      "Read(//tmp/**)",
      "Bash(gh pr:*)",
      "Bash(git log *)",
      "Bash(git:*)",
      "Bash(gh search:*)",
      "Bash(gh api *)",
      "Bash(gh release *)",
      "Bash(python3 -c:*)",
      "Bash(grep *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npm audit *)",
      "Bash(npm outdated *)",
      "mcp__ide__getDiagnostics",
      "mcp__cclsp"
    ],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh 'Terminé ✅'"
          }
        ]
      }
    ]
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "verbose": true,
  "preferredNotifChannel": "kitty",
  "autoCompactEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "mcpServers": {
    "cclsp": {
      "command": "cclsp",
      "env": {
        "CCLSP_CONFIG_PATH": "/home/kpr/.claude/cclsp.json"
      }
    }
  }
}
